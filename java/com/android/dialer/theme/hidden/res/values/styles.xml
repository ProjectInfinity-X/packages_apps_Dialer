<resources>
  <style name="Dialer" parent="Theme.Material3.DayNight">
    <item name="android:textColorLink">@color/dialer_primary</item>
    <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
    <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
  </style>

  <style name="Dialer.Dark" parent="Theme.Material3.Dark">
    <item name="android:textColorLink">@color/dialer_dark_theme_color</item>
    <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
    <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
  </style>

  <style name="DialerButtonTextStyle" parent="TextAppearance.Material3.LabelLarge">
    <item name="android:textColor">@color/dialer_on_primary</item>
  </style>

  <style name="AlertDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
    <item name="colorPrimary">@color/dialer_primary</item>
    <item name="colorOnPrimary">@color/dialer_on_primary</item>
    <item name="colorSecondary">@color/dialer_secondary</item>
    <item name="colorSurface">@color/dialer_surface_container_high</item>
    <item name="colorOnSurface">@color/dialer_on_surface</item>
    <item name="colorOnSurfaceVariant">@color/dialer_on_surface_variant</item>
    <item name="android:colorBackground">@color/dialer_surface_container_high</item>
    <item name="android:colorBackgroundFloating">@color/dialer_surface_container_high</item>
    <item name="android:textColorPrimary">@color/dialer_on_surface</item>
    <item name="android:textColorSecondary">@color/dialer_on_surface_variant</item>
    <item name="android:colorAccent">@color/dialer_primary</item>
    <item name="colorAccent">@color/dialer_primary</item>
  </style>
</resources>
