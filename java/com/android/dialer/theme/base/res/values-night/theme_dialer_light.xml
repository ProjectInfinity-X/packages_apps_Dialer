<resources>
  <style name="Dialer.ThemeBase.ActionBar">
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <style name="Dialer.ThemeBase.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>

    <item name="colorControlHighlight">@color/dialer_ripple_color</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <style name="DialerActionBarBaseTheme" parent="@style/ThemeOverlay.Material3.Dark.ActionBar">
    <item name="colorControlNormal">@color/dialer_on_surface</item>
  </style>
</resources>
