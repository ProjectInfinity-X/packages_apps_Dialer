    <item name="colorControlActivated">@color/dialer_dark_theme_color</item>

    <item name="android:statusBarColor">@android:color/system_neutral1_900</item>
    <item name="android:navigationBarColor">@android:color/system_neutral2_800</item>

    <item name="colorIcon">@android:color/system_neutral2_200</item>
    <item name="colorIconSecondary">@android:color/system_neutral2_400</item>
    <item name="colorTextOnUnthemedDarkBackground">@android:color/system_neutral1_0</item>
    <item name="colorIconOnUnthemedDarkBackground">@android:color/system_neutral1_0</item>
