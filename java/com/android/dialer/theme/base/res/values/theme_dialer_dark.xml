<resources>
  <style name="Dialer.Dark.ThemeBase.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="colorControlHighlight">#24FFFFFF</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <!-- Activities and Applications should inherit from one of the themes above. -->
  <style name="Dialer.Dark.ThemeBase">
    <item name="android:colorBackground">@android:color/system_neutral1_900</item>
    <item name="android:windowBackground">@android:color/system_neutral1_900</item>
    <item name="android:colorBackgroundFloating">@android:color/system_neutral2_700</item>
    <item name="colorSurface">@android:color/system_neutral1_900</item>
    <item name="colorOnSurface">@android:color/system_neutral1_100</item>
    <item name="colorSurfaceVariant">@android:color/system_neutral2_700</item>
    <item name="colorOnSurfaceVariant">@android:color/system_neutral2_200</item>
    <item name="colorBackgroundSearchBar">@android:color/system_neutral2_700</item>

    <item name="android:textColorPrimary">@color/dialer_dark_primary_text_color</item>
    <item name="android:textColorSecondary">@color/dialer_dark_secondary_text_color</item>
    <item name="android:textColorPrimaryInverse">@android:color/system_accent1_900</item>
    <item name="android:textColorSecondaryInverse">@android:color/system_neutral2_700</item>
    <item name="android:textColorHint">@android:color/system_neutral2_400</item>

    <item name="android:colorPrimary">@color/dialer_dark_theme_color</item>
    <item name="colorPrimary">@color/dialer_dark_theme_color</item>
    <item name="colorOnPrimary">@android:color/system_accent1_900</item>
