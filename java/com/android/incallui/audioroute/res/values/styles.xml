<resources>

  <style name="AudioRouteItem">
    <item name="android:paddingHorizontal">20dp</item>
    <item name="android:paddingVertical">14dp</item>
    <item name="android:layout_marginHorizontal">12dp</item>
    <item name="android:layout_marginVertical">2dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:background">?android:attr/selectableItemBackground</item>
    <item name="android:drawablePadding">20dp</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
    <item name="android:textColor">@color/dialer_on_surface</item>
    <item name="android:drawableTint">@color/dialer_on_surface_variant</item>
  </style>

  <style name="TransparentBottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
    <item name="android:background">@android:color/transparent</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/dialer_surface_container_high</item>
  </style>
</resources>
